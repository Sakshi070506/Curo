# --- Database ---
DATABASE_URL=sqlite+aiosqlite:///./curo.db

# --- Auth ---
JWT_SECRET=changeme
JWT_EXPIRY_MINUTES=60
AUTH_REQUIRED=false

# --- ASR / TTS (Bhashini / AI4Bharat) ---
BHASHINI_API_KEY=
BHASHINI_API_URL=

# --- OCR ---
OCR_PROVIDER=tesseract   # tesseract | vision_api
VISION_API_KEY=
VISION_API_URL=
TESSERACT_CMD=

# --- ABDM Sandbox ---
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in

# --- LLM ---
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_URL=
EMBEDDING_API_KEY=

# --- Drug Interactions ---
DRUG_INTERACTIONS_CSV=backend/data/drug_interactions.csv

# --- SMS Escalation ---
SMS_ESCALATION_NUMBERS=

# --- Security ---
ENCRYPTION_MASTER_KEY=

# --- CORS ---
CORS_ORIGINS=*

# --- Misc ---
ENV=development
LOG_LEVEL=info